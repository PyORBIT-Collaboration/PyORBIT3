"""Types for orbit.core.bunch, including optional USE_NUMPY methods."""

from typing import Any, overload

import numpy as np
from numpy.typing import ArrayLike, NDArray

class Bunch:
    def __init__(self) -> None: ...
    # Communicators are extension objects from the currently untyped orbit_mpi module.
    def getMPIComm(self) -> Any: ...
    def setMPIComm(self, mpi_comm: Any, /) -> None: ...
    def getSyncParticle(self) -> SyncParticle: ...
    def addParticle(
        self, x: float, xp: float, y: float, yp: float, z: float, dE: float, /
    ) -> int: ...
    def addParticles(self, coordinates: ArrayLike, /) -> None:
        """Append local (N, 6) coordinates in (x, xp, y, yp, z, dE) order.

        Requires a USE_NUMPY build. Uses existing units; accepts nested sequences
        and compatible NumPy arrays. Does not compress or distribute particles.
        """
    def coordinates(self) -> NDArray[np.float64]:
        """Return an owned, C-contiguous (getSize(), 6) local-coordinate snapshot.

        Requires a USE_NUMPY build. Columns are (x, xp, y, yp, z, dE) in existing
        units. No MPI communication, attributes, or reference-particle metadata.
        Does not compress or filter dead slots: call compress() after deletions
        before exporting to avoid reviving deleted particles via addParticles().
        """
    def deleteParticle(self, index: int, /) -> int: ...
    def deleteParticleFast(self, index: int, /) -> int: ...
    def recoverParticle(self, index: int, /) -> None: ...
    def deleteAllParticles(self) -> None: ...
    def compress(self) -> None: ...
    @overload
    def x(self, index: int, /) -> float: ...
    @overload
    def x(self, index: int, value: float, /) -> float: ...
    @overload
    def y(self, index: int, /) -> float: ...
    @overload
    def y(self, index: int, value: float, /) -> float: ...
    @overload
    def z(self, index: int, /) -> float: ...
    @overload
    def z(self, index: int, value: float, /) -> float: ...
    @overload
    def px(self, index: int, /) -> float: ...
    @overload
    def px(self, index: int, value: float, /) -> float: ...
    @overload
    def py(self, index: int, /) -> float: ...
    @overload
    def py(self, index: int, value: float, /) -> float: ...
    @overload
    def pz(self, index: int, /) -> float: ...
    @overload
    def pz(self, index: int, value: float, /) -> float: ...
    @overload
    def xp(self, index: int, /) -> float: ...
    @overload
    def xp(self, index: int, value: float, /) -> float: ...
    @overload
    def yp(self, index: int, /) -> float: ...
    @overload
    def yp(self, index: int, value: float, /) -> float: ...
    @overload
    def dE(self, index: int, /) -> float: ...
    @overload
    def dE(self, index: int, value: float, /) -> float: ...
    def flag(self, index: int, /) -> int: ...
    def ringwrap(self, ring_length: float, /) -> None: ...
    @overload
    def mass(self) -> float: ...
    @overload
    def mass(self, value: float, /) -> float: ...
    def classicalRadius(self) -> float: ...
    def B_Rho(self) -> float: ...
    @overload
    def charge(self) -> float: ...
    @overload
    def charge(self, value: float, /) -> float: ...
    @overload
    def macroSize(self) -> float: ...
    @overload
    def macroSize(self, value: float, /) -> float: ...
    def initBunchAttr(self, file_name: str, /) -> None: ...
    @overload
    def bunchAttrDouble(self, name: str, /) -> float: ...
    @overload
    def bunchAttrDouble(self, name: str, value: float, /) -> float: ...
    @overload
    def bunchAttrInt(self, name: str, /) -> int: ...
    @overload
    def bunchAttrInt(self, name: str, value: int, /) -> int: ...
    def bunchAttrDoubleNames(self) -> tuple[str, ...]: ...
    def bunchAttrIntNames(self) -> tuple[str, ...]: ...
    def hasBunchAttrDouble(self, name: str, /) -> int: ...
    def hasBunchAttrInt(self, name: str, /) -> int: ...
    def addPartAttr(self, name: str, params: dict[str, float] = ..., /) -> None: ...
    def removePartAttr(self, name: str, /) -> None: ...
    def removeAllPartAttr(self) -> None: ...
    def getPartAttrNames(self) -> tuple[str, ...]: ...
    def getPartAttrDicts(self) -> dict[str, dict[str, float]]: ...
    def getPossiblePartAttrNames(self) -> tuple[str, ...]: ...
    def clearAllPartAttrAndMemorize(self) -> None: ...
    def restoreAllPartAttrFromMemory(self) -> None: ...
    def hasPartAttr(self, name: str, /) -> int: ...
    def readPartAttrNames(self, file_name: str, /) -> tuple[str, ...]: ...
    def readPartAttrDicts(self, file_name: str, /) -> dict[str, dict[str, float]]: ...
    def readPartAttr(self, file_name: str, /) -> None: ...
    def getPartAttrSize(self, name: str, /) -> int: ...
    @overload
    def partAttrValue(self, name: str, part_index: int, attr_index: int, /) -> float: ...
    @overload
    def partAttrValue(
        self, name: str, part_index: int, attr_index: int, value: float, /
    ) -> float: ...
    def getSize(self) -> int: ...
    def getSizeGlobal(self) -> int: ...
    def getSizeGlobalFromMemory(self) -> int: ...
    def getTotalCount(self) -> int: ...
    def getCapacity(self) -> int: ...
    def dumpBunch(self, file_name: str = ..., /) -> None: ...
    def readBunch(self, file_name: str, nParts: int = ..., /) -> None: ...
    def copyEmptyBunchTo(self, target: Bunch, /) -> None: ...
    def copyBunchTo(self, target: Bunch, /) -> None: ...
    def addParticlesTo(self, target: Bunch, /) -> None: ...


class SyncParticle:
    """Reference particle owned by a Bunch; obtain via Bunch.getSyncParticle().

    Direct construction is reserved for the Bunch wrapper's initialization.
    """

    def __init__(self, bunch: Bunch, /) -> None: ...
    def mass(self) -> float: ...
    @overload
    def momentum(self) -> float: ...
    @overload
    def momentum(self, value: float, /) -> float: ...
    def beta(self) -> float: ...
    def gamma(self) -> float: ...
    @overload
    def kinEnergy(self) -> float: ...
    @overload
    def kinEnergy(self, value: float, /) -> float: ...
    @overload
    def time(self) -> float: ...
    @overload
    def time(self, value: float, /) -> None: ...
    @overload
    def x(self) -> float: ...
    @overload
    def x(self, value: float, /) -> None: ...
    @overload
    def y(self) -> float: ...
    @overload
    def y(self, value: float, /) -> None: ...
    @overload
    def z(self) -> float: ...
    @overload
    def z(self, value: float, /) -> None: ...
    @overload
    def px(self) -> float: ...
    @overload
    def px(self, value: float, /) -> None: ...
    @overload
    def py(self) -> float: ...
    @overload
    def py(self, value: float, /) -> None: ...
    @overload
    def pz(self) -> float: ...
    @overload
    def pz(self, value: float, /) -> None: ...
    @overload
    def pVector(self) -> tuple[float, float, float]: ...
    @overload
    def pVector(self, value: tuple[float, float, float], /) -> None: ...
    @overload
    def rVector(self) -> tuple[float, float, float]: ...
    @overload
    def rVector(self, value: tuple[float, float, float], /) -> None: ...
    @overload
    def nxVector(self) -> tuple[float, float, float]: ...
    @overload
    def nxVector(self, value: tuple[float, float, float], /) -> None: ...
    def nyVector(self) -> tuple[float, float, float]: ...
    def energyToMomentum(self, value: float, /) -> float: ...
    def momentumToEnergy(self, value: float, /) -> float: ...


